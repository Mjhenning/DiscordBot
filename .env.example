# Discord
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-guild-id

# Twitch
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret
TWITCH_CHANNEL_NAME=your-twitch-channel
TWITCH_USER_ID=your-twitch-user-id
FOX_DISCORD_ID=your-discord-user-id

# Twitch OAuth Tokens (get from https://twitchapps.com/tmi/)
TWITCH_BROADCASTER_TOKEN=your-broadcaster-token
TWITCH_BOT_TOKEN=your-bot-token

# Channel IDs
TWITCH_NOTIFY_CHANNEL_ID=channel-id
SUGGESTION_CHANNEL_ID=channel-id
WELCOME_CHANNEL_ID=channel-id
FAVOURITES_NOTIFY_CHANNEL_ID=channel-id
MOD_LOG_CHANNEL_ID=channel-id

# Role IDs
AUTO_ROLE_ID=role-id
TWITCH_NOTIFY_ROLE_ID=role-id
SCHEDULE_NOTI_ROLE_ID=role-id
LIVE_GUEST_ROLE_ID=role-id

# Twitch Reward IDs
SUGGEST_REWARD_ID=reward-uuid
QUOTE_REWARD_ID=reward-uuid

# Paths (optional, has default)
#QUOTE_DIRECTORY=../../Overlay/Scripts
